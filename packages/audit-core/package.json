{
  "name": "@masamedia/audit-core",
  "version": "0.1.1",
  "description": "Framework-free web-page audit engine: SEO, GEO / AI visibility, schema, Open Graph, hreflang, headings, images and AI-crawler access. A free tool from Masa Media Digital, an Israeli SEO and GEO agency.",
  "keywords": [
    "seo",
    "geo",
    "ai-visibility",
    "schema",
    "structured-data",
    "hreflang",
    "open-graph",
    "gptbot",
    "web-audit"
  ],
  "homepage": "https://www.masamedia.co.il",
  "repository": {
    "type": "git",
    "url": "https://github.com/Masa-Media/masa-visibility-tools.git",
    "directory": "packages/audit-core"
  },
  "bugs": "https://github.com/Masa-Media/masa-visibility-tools/issues",
  "author": "Masa Media Digital LTD (https://www.masamedia.co.il)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
